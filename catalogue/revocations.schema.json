{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TwickaS/delorun-plugins/catalogue/revocations.schema.json",
  "title": "Revocation list source",
  "description": "The source of the revocation list. The fields of each revocation follow the catalogue contract at https://github.com/TwickaS/delorun/blob/main/delorun/docs/contracts/c13-catalogue-revocation.md. The publish job adds the sequence number and the issue and expiry times when it signs the list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["revocations"],
  "properties": {
    "revocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "versions", "reason", "message", "revoked"],
        "properties": {
          "package": { "$ref": "entry.schema.json#/$defs/packageName" },
          "versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "entry.schema.json#/$defs/semver" } },
          "reason": { "enum": ["malicious", "vulnerable", "broken", "author-request"] },
          "message": { "type": "string", "minLength": 1, "maxLength": 500 },
          "advisory": { "$ref": "entry.schema.json#/$defs/httpsUrl" },
          "revoked": { "$ref": "entry.schema.json#/$defs/timestamp" }
        }
      }
    }
  }
}
